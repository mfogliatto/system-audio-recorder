<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>1.0.4</Version>
    <Authors>Marco Fogliatto</Authors>
    <Copyright>Copyright (c) 2026 Marco Fogliatto</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PathMap>$(MSBuildThisFileDirectory)=C:\_src\SystemAudioRecorder\</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="LICENSE"
          Pack="true" PackagePath="\" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
